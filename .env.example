# Server only. Never use VITE_ for secrets.
KIS_API_KEY=
KIS_API_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=01
KIS_ENV=prod
# Optional: without this, fills are checked through REST.
KIS_HTS_ID=
# Browser unlock password. Required, never sent to the browser.
CT_PW=
# Optional runtime settings
HOST=127.0.0.1
PORT=5197
KIS_TOKEN_STATE_PATH=/tmp/kis_access_token_state.json
